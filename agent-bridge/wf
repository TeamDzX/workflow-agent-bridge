#!/usr/bin/env python3
"""wf — talk to WorkFlow's Agent Bridge from the command line.

The minimum writer side for the bridge: send commands, wait for receipts, and
read tasks and comment threads.

Reads come from `snapshot.json` in the bridge folder — the app's own export of
tasks, comments, checklists and notes, rewritten after every save. That matters
more than it looks: the SQLite store sits inside the app's sandbox container,
which a background process (a launchd-started session, say) cannot open at all.
The snapshot lives wherever the bridge does, so it's readable from anywhere.
When there is no snapshot yet, reads fall back to the store, read-only.

Writes always go through the app (a command file it drains). Never write to
the store: Core Data logs every save into persistent-history tables and
NSPersistentCloudKitContainer exports from that log — a raw INSERT lands on this
Mac and never reaches the phone.

Where the bridge is, in order:
  1. $WF_BRIDGE                      — set explicitly (the wake script does this)
  2. the app's location.json pointer — inside the container; a terminal can read it
  3. the container itself            — where the bridge lives until a folder is chosen

Usage
  wf state                          Bridge status, folder, snapshot age
  wf ping                           Confirm the app is watching
  wf setup                          Install the agent workspace and its smart list
  wf wake install|status|uninstall  launchd trigger: assigning a task wakes Claude
  wf tasks [--all]                  List active tasks
  wf queue                          Tasks assigned to the agent
  wf show <task>                    One task with its comment thread
  wf comment <task> <text>          Post a comment as the agent
  wf poll [--since ISO8601]         Comments addressed to the agent since a mark
  wf add <title> [...]              Create a task
  wf check|uncheck <task> <sub>...  Tick subtasks
  wf rename <task> <old> <new>      Retitle a subtask in place (tick kept)
  wf status <task> <text>           Set a task's pinned note (its status line)
  wf done <task>                    Complete a task
  wf project <name> [...]           Create or update a project
  wf pack <file.json>               Install a ProjectPack
  wf notes [--all]                  The Notepad inbox
  wf note <note>                    One note in full
  wf jot <title> [--body TEXT]      File output into the Notepad
  wf convert <note> [--subtask S]   Promote a note into a task
  wf reply <note> <text>            Append a signed reply inside the note
  wf attach <task> <file> [--name N] Attach a file to a task
  wf sweep [--apply] [--json]        Portfolio sweep: notes → per-app fixes, versions
  wf sweep install|status|uninstall  Weekly launchd job that runs the sweep in a session
  wf session [CODEBASE]             Claude's own cross-session log for this codebase
  wf session --log TEXT             Append a session comment (creates the task on first use)
  wf session --state TEXT           Replace the one-line current state
  wf session --open S / --close S   Add / tick an open loop
  wf session --list                 Every codebase with its state line
  wf session --attach FILE [--to T] Attach evidence (screenshot, report, export) and say where it came from
  wf session --weekly               Post the week's session counts on the housekeeping task
  wf handoff TITLE [--project P] [--notes/--command ...]  A task for you, tagged needs-<you>
  wf job TITLE [--template T] [--step S...]  A checklist task Claude ticks as it works

<task> / <note> is an id or a case-insensitive fragment of the title.
"""

import argparse
import getpass
import json
import os
import plistlib
import sqlite3
import sys
import time
import uuid
from datetime import datetime, timezone
from pathlib import Path

# The Mac app's own container. WF_CONTAINER overrides it — useful against a
# simulator install, or a second copy of the app.
CONTAINER = Path(
    os.environ.get(
        "WF_CONTAINER",
        Path.home() / "Library/Containers/mac.TeamDZX.worflow/Data/Library/Application Support",
    )
)

AGENT_AUTHOR_ID = "agent.claude"
AGENT_NAME = "Claude"
NOTE_MARKER = "@claude"

# Resolved once. There is a symlink to the repo on the Desktop for convenience,
# and macOS keeps background processes out of the Desktop — so every path this
# tool bakes into launchd config must be the real one, never the path it
# happened to be invoked through.
HERE = Path(__file__).resolve().parent
WORKSPACE_PACK = HERE / "claude-workspace.json"

# Core Data stores seconds since 2001-01-01, not the Unix epoch.
APPLE_EPOCH_OFFSET = 978307200
EPOCH = datetime.min.replace(tzinfo=timezone.utc)


def resolve_bridge():
    explicit = os.environ.get("WF_BRIDGE")
    if explicit:
        return Path(explicit)
    pointer = CONTAINER / "AgentBridge" / "location.json"
    try:
        root = json.loads(pointer.read_text()).get("root")
        if root and Path(root).is_dir():
            return Path(root)
    except (OSError, ValueError):
        pass
    return CONTAINER / "AgentBridge"


BRIDGE = resolve_bridge()
INBOX, OUTBOX = BRIDGE / "inbox", BRIDGE / "outbox"
ATTACHMENTS = BRIDGE / "attachments"
STATE, SNAPSHOT = BRIDGE / "state.json", BRIDGE / "snapshot.json"
WATERMARK = BRIDGE / ".wf-watermark"


def die(msg, code=1):
    print(f"wf: {msg}", file=sys.stderr)
    sys.exit(code)


def read_state():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


# ------------------------------------------------------------------ reading

def parse_iso(value):
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def apple_time(seconds):
    if seconds is None:
        return None
    return datetime.fromtimestamp(seconds + APPLE_EPOCH_OFFSET, tz=timezone.utc)


def uuid_str(value):
    """ZID is a 16-byte BLOB, not text — Core Data stores UUIDs raw."""
    if value is None:
        return None
    if isinstance(value, (bytes, bytearray)):
        try:
            return str(uuid.UUID(bytes=bytes(value)))
        except ValueError:
            return None
    return str(value)


def load_snapshot():
    try:
        return json.loads(SNAPSHOT.read_text())
    except (OSError, ValueError):
        return None


def live_store():
    """Which store the app actually opened — the fallback when there's no
    snapshot. state.json says so outright when the bridge is on; otherwise
    the most recently written store file, because this Mac runs on
    freshStore.store rather than default.store."""
    path = read_state().get("storePath")
    if path and Path(path).exists():
        return Path(path)
    candidates = []
    for store in CONTAINER.glob("*.store"):
        wal = store.with_name(store.name + "-wal")
        mtime = max(store.stat().st_mtime, wal.stat().st_mtime if wal.exists() else 0)
        candidates.append((mtime, store))
    if not candidates:
        die("no snapshot in the bridge folder and no SwiftData store under "
            f"{CONTAINER}\n     Is WorkFlow running with Settings > Agent Bridge on?")
    return max(candidates)[1]


def query(sql, params=()):
    uri = f"file:{live_store()}?mode=ro"
    try:
        conn = sqlite3.connect(uri, uri=True)
    except sqlite3.OperationalError as exc:
        die(f"couldn't open the store ({exc}). A background session can't reach "
            "the app's container — choose a Bridge Folder in WorkFlow's Settings "
            "so the app writes snapshot.json somewhere readable.")
    try:
        conn.row_factory = sqlite3.Row
        return conn.execute(sql, params).fetchall()
    finally:
        conn.close()


def _blob_json(blob):
    if not blob:
        return []
    try:
        return json.loads(bytes(blob).decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        return []


def _comment(c, ts):
    return {"id": c.get("id"), "author": c.get("author", "?"), "authorID": c.get("authorID"),
            "text": c.get("text", ""), "ts": ts}


def all_tasks(include_hidden=False):
    """Every task as a plain dict, from the snapshot if there is one."""
    snap = load_snapshot()
    rows = []
    if snap is not None:
        for t in snap.get("tasks", []):
            if not include_hidden and t.get("isHidden"):
                continue
            rows.append({
                "id": (t.get("id") or "").lower(),
                "title": t.get("title", ""),
                "status": t.get("status", ""),
                "priority": t.get("priority", ""),
                "project": t.get("project", ""),
                "assignee": t.get("assignee", ""),
                "due": parse_iso(t.get("dueDate")),
                "updated": parse_iso(t.get("updatedAt")),
                "pinnedNote": t.get("pinnedNote", ""),
                "notes": t.get("notes", ""),
                "subtasks": t.get("subtasks", []),
                "comments": sorted((_comment(c, parse_iso(c.get("timestamp")))
                                    for c in t.get("comments", [])),
                                   key=lambda c: c["ts"] or EPOCH),
            })
    else:
        clause = "" if include_hidden else "WHERE ZISMINIMIZED = 0 AND ZARCHIVEDAT IS NULL"
        for r in query(f"SELECT ZID, ZTITLE, ZSTATUS, ZPRIORITY, ZPROJECT, ZASSIGNEE, ZDUEDATE, "
                       f"ZUPDATEDAT, ZPINNEDNOTE, ZSTRIPPEDNOTES, ZNOTES, ZSUBTASKSDATA, "
                       f"ZCOMMENTSDATA FROM ZPMTASK {clause}"):
            rows.append({
                "id": (uuid_str(r["ZID"]) or "").lower(),
                "title": r["ZTITLE"] or "",
                "status": r["ZSTATUS"] or "",
                "priority": r["ZPRIORITY"] or "",
                "project": r["ZPROJECT"] or "",
                "assignee": r["ZASSIGNEE"] or "",
                "due": apple_time(r["ZDUEDATE"]),
                "updated": apple_time(r["ZUPDATEDAT"]),
                "pinnedNote": r["ZPINNEDNOTE"] or "",
                "notes": r["ZSTRIPPEDNOTES"] or r["ZNOTES"] or "",
                "subtasks": _blob_json(r["ZSUBTASKSDATA"]),
                "comments": sorted((_comment(c, apple_time(c.get("timestamp")))
                                    for c in _blob_json(r["ZCOMMENTSDATA"])),
                                   key=lambda c: c["ts"] or EPOCH),
            })
    return sorted(rows, key=lambda r: r["updated"] or EPOCH, reverse=True)


def all_notes(include_archived=False):
    snap = load_snapshot()
    rows = []
    if snap is not None:
        for n in snap.get("notes", []):
            if not include_archived and n.get("isArchived"):
                continue
            rows.append({
                "id": (n.get("id") or "").lower(),
                "title": n.get("title", ""), "body": n.get("body", ""),
                "isPinned": bool(n.get("isPinned")), "isArchived": bool(n.get("isArchived")),
                "convertedAt": parse_iso(n.get("convertedAt")),
                "convertedTargetName": n.get("convertedTargetName", ""),
                "updated": parse_iso(n.get("updatedAt")),
            })
    else:
        clause = "" if include_archived else "WHERE ZISARCHIVED = 0"
        for r in query(f"SELECT ZID, ZTITLE, ZBODY, ZISPINNED, ZISARCHIVED, ZCONVERTEDAT, "
                       f"ZCONVERTEDTARGETNAME, ZUPDATEDAT FROM ZPMNOTE {clause}"):
            rows.append({
                "id": (uuid_str(r["ZID"]) or "").lower(),
                "title": r["ZTITLE"] or "", "body": r["ZBODY"] or "",
                "isPinned": bool(r["ZISPINNED"]), "isArchived": bool(r["ZISARCHIVED"]),
                "convertedAt": apple_time(r["ZCONVERTEDAT"]),
                "convertedTargetName": r["ZCONVERTEDTARGETNAME"] or "",
                "updated": apple_time(r["ZUPDATEDAT"]),
            })
    return sorted(rows, key=lambda r: (not r["isPinned"], -(r["updated"] or EPOCH).timestamp()))


def _find(rows, needle, kind, haystack):
    try:
        wanted = str(uuid.UUID(needle)).lower()
        for row in rows:
            if row["id"] == wanted:
                return row
        die(f"no {kind} with id {needle}")
    except ValueError:
        pass
    matches = [r for r in rows if needle.lower() in haystack(r).lower()]
    if not matches:
        die(f'no active {kind} matching "{needle}"')
    if len(matches) > 1:
        print(f'wf: "{needle}" matched {len(matches)} {kind}s, using the most recent:', file=sys.stderr)
        for row in matches[:5]:
            print(f"      {row['title']}", file=sys.stderr)
    return matches[0]


def find_task(needle):
    """A UUID matches exactly; anything else matches a title fragment."""
    return _find(all_tasks(), needle, "task", lambda r: r["title"])


def find_note(needle):
    return _find(all_notes(), needle, "note", lambda r: r["title"] + " " + r["body"])


def note_title(row):
    """Mirrors PMNote.displayTitle: fall back to the first body line."""
    title = (row["title"] or "").strip()
    if title:
        return title
    for line in (row["body"] or "").splitlines():
        if line.strip():
            return line.strip()[:60]
    return "Untitled note"


def local(dt):
    return dt.astimezone() if dt else None


# ------------------------------------------------------------------ writing

def send(op, wait=True, **fields):
    if not INBOX.exists():
        die(f"inbox not found at {INBOX}\n"
            "     Turn on WorkFlow > Settings > Agent Bridge.")
    command = {"id": f"wf-{int(time.time() * 1000)}-{uuid.uuid4().hex[:6]}", "op": op}
    command.update({k: v for k, v in fields.items() if v is not None})

    # Atomic: the app skips a half-written file for 5s, then calls it malformed.
    tmp = INBOX / f".{command['id']}.tmp"
    tmp.write_text(json.dumps(command, indent=2))
    tmp.rename(INBOX / f"{command['id']}.json")

    if not wait:
        print(command["id"])
        return None

    receipt_path = OUTBOX / f"{command['id']}.json"
    deadline = time.time() + 30
    while time.time() < deadline:
        if receipt_path.exists():
            try:
                receipt = json.loads(receipt_path.read_text())
            except ValueError:
                time.sleep(0.2)
                continue
            status = receipt.get("status", "?")
            message = receipt.get("message", "")
            marker = "ok" if status == "applied" else status
            print(f"[{marker}] {message}")
            if receipt.get("taskID"):
                print(f"       task {receipt['taskID']}")
            if status != "applied":
                sys.exit(2)
            wait_for_snapshot(after=receipt_path.stat().st_mtime)
            return receipt
        time.sleep(0.25)
    die("timed out after 30s — is WorkFlow running with the bridge switched on?", 3)


def wait_for_snapshot(after, timeout=6.0):
    """Read-your-writes. The app rewrites snapshot.json about two seconds after
    it applies a command, so a read straight after a write would see the old
    world — `wf add X && wf attach X` failed on exactly that. Block until the
    snapshot is newer than the receipt, or give up quietly and let the reader
    take its chances."""
    if not SNAPSHOT.exists():
        return
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            if SNAPSHOT.stat().st_mtime > after:
                return
        except OSError:
            return
        time.sleep(0.2)


# ---------------------------------------------------------------- commands

def cmd_state(args):
    state = read_state()
    if not state:
        print(f"Bridge has never been enabled (no {STATE}).")
    else:
        print(f"enabled     {state.get('enabled')}")
        print(f"app         {state.get('appVersion')} ({state.get('build')})")
        print(f"folder      {state.get('root')}"
              f"{'' if state.get('folderChosen') else '   (inside the app — choose a Bridge Folder to run unattended)'}")
        print(f"last action {state.get('lastActivityAt', '—')}")
        print(f"ops         {', '.join(state.get('ops', []))}")
    snap = load_snapshot()
    if snap:
        generated = parse_iso(snap.get("generatedAt")) or datetime.now(timezone.utc)
        age = int((datetime.now(timezone.utc) - generated).total_seconds())
        print(f"snapshot    {len(snap.get('tasks', []))} tasks, {len(snap.get('notes', []))} notes, {age}s old")
    else:
        print("snapshot    none — reads fall back to the store (interactive only)")


def cmd_tasks(args):
    rows = all_tasks(include_hidden=args.all)
    if not rows:
        print("No tasks.")
        return
    for row in rows:
        bits = [f"{(row['status'] or '?'):<12}", f"{row['title'][:46]:<46}"]
        if row["project"]:
            bits.append(f"[{row['project']}]")
        if row["due"]:
            bits.append(local(row["due"]).strftime("due %Y-%m-%d"))
        print("  ".join(bits))
        print(f"    {row['id']}")


def print_thread(comments):
    if not comments:
        print("\nNo comments.")
        return
    print(f"\n{len(comments)} comment(s):")
    for c in comments:
        stamp = local(c["ts"]).strftime("%Y-%m-%d %H:%M") if c["ts"] else "?"
        print(f"\n  {c['author']} · {stamp}")
        for line in (c["text"] or "").splitlines() or [""]:
            print(f"    {line}")


def cmd_show(args):
    task = find_task(args.task)
    print(f"{task['title']}  ({task['status']})")
    print(f"id {task['id']}")
    if task["pinnedNote"]:
        print(f"status: {task['pinnedNote']}")
    for item in task["subtasks"]:
        print(f"  [{'x' if item.get('isCompleted') else ' '}] {item.get('title', '')}")
    print_thread(task["comments"])


def cmd_queue(args):
    """The agent's inbox: tasks whose assignee is the agent — the app's own
    ownership field, so you assign from the phone exactly as you'd assign to
    a person, and My Work already renders the mirror image."""
    rows = [r for r in all_tasks()
            if r["assignee"].lower() == AGENT_NAME.lower() and r["status"] != "Completed"]
    rows.sort(key=lambda r: r["due"] or datetime.max.replace(tzinfo=timezone.utc))
    if not rows:
        print(f"Nothing assigned to {AGENT_NAME}.")
        sys.exit(1)
    for row in rows:
        head = f"{row['title']}  [{row['status']}"
        if row["priority"]:
            head += f", {row['priority']}"
        head += "]"
        if row["due"]:
            head += f"  due {local(row['due']):%Y-%m-%d}"
        print(head)
        print(f"  {row['id']}")
        if row["pinnedNote"]:
            print(f"  status: {row['pinnedNote']}")
        for item in row["subtasks"]:
            print(f"    [{'x' if item.get('isCompleted') else ' '}] {item.get('title', '')}")
        if row["comments"]:
            last = row["comments"][-1]
            print(f"  last: {last['author']} — {(last['text'] or '')[:90]}")
        print()
    sys.exit(0)


def cmd_poll(args):
    """Comments the user has left since the last poll. Cheap by design: one
    read on the ticks where nothing happened, and an exit code (1 = nothing)
    a loop can branch on."""
    since = args.since
    if since is None and WATERMARK.exists():
        since = WATERMARK.read_text().strip() or None
    cutoff = parse_iso(since) if since else None
    if since and cutoff is None:
        die(f"couldn't read --since {since!r}; expected ISO-8601")
    cutoff = cutoff or EPOCH

    found, newest = [], cutoff
    for row in all_tasks():
        for c in row["comments"]:
            ts = c["ts"]
            if not ts:
                continue
            if ts > newest:
                newest = ts
            if ts <= cutoff or c["authorID"] == AGENT_AUTHOR_ID:
                continue
            found.append((ts, row, c))

    for ts, row, c in sorted(found, key=lambda item: item[0]):
        print(f"{row['title']}  ·  {c['author']}  ·  {local(ts):%Y-%m-%d %H:%M}")
        print(f"  {c['text']}")
        print(f"  reply: wf comment {row['id']} '...'")
        print()

    if not found:
        print("Nothing new.")
    if newest > cutoff:
        BRIDGE.mkdir(parents=True, exist_ok=True)
        WATERMARK.write_text(newest.isoformat())
    sys.exit(0 if found else 1)


def cmd_check(args):
    task = find_task(args.task)
    key = "uncheckSubtasks" if args.uncheck else "checkSubtasks"
    send("update_task", **{"taskID": task["id"], key: args.subtask})


def cmd_rename(args):
    task = find_task(args.task)
    send("update_task", taskID=task["id"], renameSubtasks=[{"from": args.old, "to": args.new}])


def cmd_status(args):
    task = find_task(args.task)
    send("update_task", taskID=task["id"], pinnedNote=args.text)


def cmd_setup(args):
    """Stands up the agent's workspace: the project, its standing tasks, and
    the smart list that surfaces them on every device."""
    if not WORKSPACE_PACK.exists():
        die(f"workspace pack missing at {WORKSPACE_PACK}")
    pack = json.loads(WORKSPACE_PACK.read_text())
    send("install_pack", pack=pack, createProjects=True, skipExistingProjects=True)
    send("create_smart_list", name=AGENT_NAME, icon="sparkles", colorHex="#0F6B6B",
         filters={"assignee": AGENT_NAME, "sort": "Due Date"})
    print(f"\nOpen WorkFlow → Projects → Smart Lists → {AGENT_NAME}.")
    print(f"Assign any task to \"{AGENT_NAME}\" and it lands in `wf queue`.")


def cmd_notes(args):
    rows = all_notes(include_archived=args.all)
    if not rows:
        print("Notepad is empty.")
        sys.exit(1)
    for row in rows:
        flags = []
        if row["isPinned"]:
            flags.append("pinned")
        if row["convertedAt"]:
            flags.append(f"-> {row['convertedTargetName']}")
        body = (row["body"] or "").strip().replace("\n", " ")
        marker = "*" if NOTE_MARKER in (row["title"] + body).lower() else " "
        head = f"{marker} {note_title(row)}"
        if flags:
            head += f"  ({', '.join(flags)})"
        print(head)
        if body:
            print(f"    {body[:96]}")
        print(f"    {row['id']}")
    print(f"\n* = marked {NOTE_MARKER}")
    sys.exit(0)


def cmd_note(args):
    row = find_note(args.note)
    print(note_title(row))
    print(f"id {row['id']}")
    if row["convertedAt"]:
        print(f"converted -> {row['convertedTargetName']}")
    print()
    print(row["body"] or "(empty)")


def cmd_jot(args):
    send("create_note", title=args.title, notes=args.body,
         colorHex=args.color, isPinned=args.pin or None)


def cmd_convert(args):
    row = find_note(args.note)
    send("convert_note", noteID=row["id"], project=args.project,
         title=args.title, priority=args.priority, dueDate=args.due,
         assignee=args.assignee, subtasks=args.subtask or None)


def cmd_attach(args):
    """Stage the file inside the bridge folder, then ask the app to take it.

    The app is sandboxed and can only open files inside its own container or
    the chosen bridge folder, so a file anywhere else has to be copied in
    first. The app deletes the staged copy once the bytes are in the store.
    """
    import shutil
    src = Path(args.file).expanduser()
    if not src.is_file():
        die(f"no such file: {src}")
    task = find_task(args.task)
    ATTACHMENTS.mkdir(parents=True, exist_ok=True)
    staged = ATTACHMENTS / src.name
    # A source already inside attachments/ is fine — just use it.
    if Path(src).resolve() != staged.resolve():
        shutil.copyfile(src, staged)
    send("attach_file", taskID=task["id"], fileName=src.name, displayName=args.name)


def cmd_reply(args):
    """Answer a note *in the note*. Notes have no comment thread, so the reply
    is appended to the body — signed and dated, never overwriting a word of
    what was there — which is what shows up in the Notepad on the phone."""
    row = find_note(args.note)
    send("update_note", noteID=row["id"], appendText=args.text,
         isPinned=args.pin or None)


# ------------------------------------------------------------------ sweep

INDEX_TASK = "Sprint and Updates"
SWEEP_STATE = BRIDGE / "sweep-state.json"
PORTFOLIO_PROJECT = "Opticell"
PORTFOLIO_TAG = "portfolio"
SELLER = "opticell"


def _app_names_from_index():
    """The index task's checklist is the source of truth for which apps exist.
    Each subtask reads "Name — version (source)"; the name is what's before
    the dash."""
    idx = _find(all_tasks(include_hidden=True), INDEX_TASK, "task", lambda r: r["title"])
    names = []
    for item in idx["subtasks"]:
        title = item.get("title", "")
        name = title.split(" — ")[0].split(" – ")[0].strip()
        if name:
            names.append((name, title))
    return idx, names


def _match_app(text, names):
    """Longest app name mentioned in the text wins, so 'myllm android' beats
    'myllm'. Case-insensitive; punctuation in names is tolerated."""
    low = text.lower()
    best, best_len = None, 0
    for name, _ in names:
        key = name.lower().replace(".stl", "").strip()
        variants = {key, key.replace(" - ", " "), key.replace("-", " "), key.replace(" ", "")}
        for v in variants:
            if v and v in low.replace("-", " ") and len(v) > best_len:
                best, best_len = name, len(v)
    return best


def _store_versions():
    """Live App Store versions for everything this seller publishes, iOS and
    Mac, keyed by lower-cased track name. Empty on any network failure — the
    sweep must still run offline."""
    import urllib.request
    out = {}
    for entity in ("software", "macSoftware"):
        url = f"https://itunes.apple.com/search?term={SELLER}&entity={entity}&limit=50&country=gb"
        try:
            with urllib.request.urlopen(url, timeout=15) as r:
                data = json.load(r)
        except Exception:
            continue
        for r in data.get("results", []):
            if SELLER in (r.get("sellerName") or "").lower():
                out[r["trackName"].lower()] = (r.get("version"), (r.get("currentVersionReleaseDate") or "")[:10], entity)
    return out


def _version_for(name, store):
    """Match a checklist name to a store track name by word overlap, preferring
    the most specific track: 'Drawpad Pro' must land on 'DrawPad Pro.stl', not
    'DrawPad' (which shares the first word and came first in the dict).
    Android rows never match — the App Store has no Android builds."""
    if "android" in name.lower():
        return None
    def words(t):
        t = t.lower().replace(".stl", "").replace("—", " ").replace("-", " ").replace(":", " ")
        return [w for w in t.split() if w]
    key = words(name)
    if not key:
        return None
    best, best_score = None, 0.0
    for track, v in store.items():
        tw = words(track)
        matched = sum(1 for w in key if w in tw)
        if matched == 0:
            continue
        # every key word should be present for a multi-word key; otherwise
        # it's a weak first-word hit and a longer track name must not win it
        if matched < len(key) and len(key) > 1:
            continue
        score = matched - 0.01 * (len(tw) - matched)
        if score > best_score:
            best, best_score = v, score
    return best


def _load_sweep_state():
    try:
        return json.loads(SWEEP_STATE.read_text())
    except (OSError, ValueError):
        return {"filedNotes": {}}


def cmd_sweep(args):
    if getattr(args, "action", None) in ("install", "status", "uninstall"):
        return sweep_launchd(args)

    idx, names = _app_names_from_index()
    state = _load_sweep_state()
    store = _store_versions()

    # 1. versions: what the checklist says vs what the store says now
    drift = []
    for name, title in names:
        live = _version_for(name, store)
        if not live:
            continue
        shown = title.split(" — ", 1)[1] if " — " in title else ""
        if live[0] and live[0] not in shown:
            drift.append((name, live[0], live[1], title))

    # 2. notes: unarchived, unconverted, mentioning an app, not yet filed
    filed = state["filedNotes"]
    matched, unmatched = [], []
    for n in all_notes():
        if n["convertedAt"] or n["id"] in filed:
            continue
        app = _match_app(n["title"] + " " + n["body"], names)
        (matched if app else unmatched).append((app, n))

    # 3. open per-app fix lists
    open_lists = [t for t in all_tasks() if t["title"].endswith(" — updates & fixes") and t["status"] != "Completed"]

    if args.json:
        print(json.dumps({
            "apps": [n for n, _ in names],
            "versionDrift": [{"app": a, "live": v, "released": d, "checklist": t} for a, v, d, t in drift],
            "notes": [{"app": a, "id": n["id"], "title": note_title(n), "body": n["body"]} for a, n in matched],
            "unmatchedNotes": [{"id": n["id"], "title": note_title(n), "body": n["body"][:200]} for _, n in unmatched],
            "openLists": [{"task": t["title"], "id": t["id"],
                           "open": [i["title"] for i in t["subtasks"] if not i.get("isCompleted")]} for t in open_lists],
        }, indent=2))
    else:
        print(f"PORTFOLIO SWEEP — {len(names)} apps on the index")
        print("\nVersion drift (store newer than the checklist):")
        for a, v, d, _ in drift or []:
            print(f"  {a:24} store {v} ({d})")
        if not drift:
            print("  none — checklist matches the App Store" if store else "  (App Store unreachable; skipped)")
        print(f"\nNotes to file ({len(matched)}):")
        for a, n in matched:
            print(f"  [{a}] {note_title(n)}  ·  {n['id']}")
        if not matched:
            print("  none")
        if unmatched:
            print(f"\nNotes mentioning no app ({len(unmatched)}) — left alone:")
            for _, n in unmatched:
                print(f"  {note_title(n)}  ·  {n['id']}")
        print(f"\nOpen fix lists ({len(open_lists)}):")
        for t in open_lists:
            pending = [i for i in t["subtasks"] if not i.get("isCompleted")]
            print(f"  {t['title']:40} {len(pending)} open")
        if not open_lists:
            print("  none yet — created on first filing")

    if not args.apply:
        return

    # ---- apply: file each matched note under its app's list -------------
    ops_supported = set(read_state().get("ops", []))
    can_reply = "update_note" in ops_supported
    for app, n in matched:
        list_title = f"{app} — updates & fixes"
        existing = next((t for t in all_tasks() if t["title"] == list_title), None)
        line = note_title(n)[:120]
        if existing:
            send("update_task", taskID=existing["id"], addSubtasks=[line])
        else:
            ver = _version_for(app, store)
            send("create_task", title=list_title, project=PORTFOLIO_PROJECT, tags=[PORTFOLIO_TAG],
                 priority="Medium", dueDate="2027-09-01",
                 pinnedNote=f"Live: {ver[0]}" if ver else "",
                 notes=f"Updates and bug fixes for {app}. Filed by the weekly sweep from Notepad notes that mention the app; each subtask is one note. The due date is parked a year out — this is a standing list, not a deadline.",
                 subtasks=[line])
        if can_reply:
            send("update_note", noteID=n["id"], appendText=f"Filed under “{list_title}”.")
        filed[n["id"]] = {"app": app, "at": datetime.now(timezone.utc).isoformat()}
    # versions: refresh the index checklist in place (replace, so re-read first)
    if drift:
        idx, names = _app_names_from_index()
        new_titles = []
        for name, title in names:
            hit = next((d for d in drift if d[0] == name), None)
            if hit:
                _, v, date, _ = hit
                src = "Mac App Store" if (_version_for(name, store) or ("", "", ""))[2] == "macSoftware" else "App Store"
                # Same shape as the hand-written lines: "29 Aug", not ISO.
                try:
                    nice = datetime.strptime(date, "%Y-%m-%d").strftime("%-d %b")
                except ValueError:
                    nice = date
                new_titles.append(f"{name} — {v}  ({src}, {nice})")
            else:
                new_titles.append(title)
        send("update_task", taskID=idx["id"], subtasks=new_titles,
             pinnedNote=f"Versions refreshed by the sweep {datetime.now():%-d %b}. {len(names)} apps.")
    SWEEP_STATE.write_text(json.dumps(state, indent=2))
    print(f"\napplied: {len(matched)} note(s) filed, {len(drift)} version(s) refreshed")


