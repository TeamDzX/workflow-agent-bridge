                print(f"  {line}")
        open_loops = [i for i in task["subtasks"] if not i.get("isCompleted")]
        if open_loops:
            print("\nopen loops:")
            for i in open_loops:
                print(f"  [ ] {i.get('title', '')}")
        comments = task["comments"] if args.all else task["comments"][-3:]
        if comments and not args.all and len(task["comments"]) > 3:
            print(f"\n(last 3 of {len(task['comments'])} sessions — --all for the rest)")
        print_thread(comments)
        return

    fields = {}
    if args.state:
        fields["pinnedNote"] = args.state
    if args.open:
        fields["addSubtasks"] = args.open
    if args.close:
        fields["checkSubtasks"] = args.close
    if fields:
        send("update_task", taskID=task["id"], **fields)

    # Evidence: the file goes on the task (this one, or --to another), and the
    # comment says what it is and where the original lives, so it can be found
    # again without knowing the folder.
    attached = []
    if args.attach:
