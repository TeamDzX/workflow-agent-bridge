        send("add_comment", taskID=task["id"], text=text)


def _agenda_text(buckets, alerts, days, limit=5):
    counts = {k: len(v) for k, v in buckets.items()}
    head = (f"Agenda for {datetime.now():%A %-d %B} — "
            f"{counts['overdue']} overdue, {counts['today']} due today, "
            f"{counts['soon']} in the next {days} days, "
            f"{counts['upcoming']} later, {counts['undated']} with no date.")
    lines = [head]
    # `hasReminder` is None on a pre-4.7 snapshot: say nothing rather than
    # report "0 alerts", which would be a claim the data can't support.
    if any(t.get("hasReminder") is not None for v in buckets.values() for t in v):
        lines.append(f"{len(alerts)} of them carry an alert.")
    for key, title in (("overdue", "Overdue"), ("today", "Today"), ("soon", "Next up")):
        rows = buckets[key]
        if not rows:
            continue
        lines.append("")
        lines.append(f"{title} ({len(rows)})")
        for t in rows[:limit]:
            lines.append(f"  · {_agenda_line(t)}")
        if len(rows) > limit:
            lines.append(f"  … and {len(rows) - limit} more")
    return "\n".join(lines)


