# ---------------------------------------------------------------- mail (Tier 3)
#
# `wf mail` reads the UNREAD set of an iCloud inbox over IMAP so a scheduled
# session (claude-mail.sh) can turn what needs doing into tasks. Read-only by
# construction: the mailbox is SELECTed read-only and nothing is ever STOREd,
# so no flag changes, no moves, no deletes — Mail on the phone won't even see
# the messages as read. The only state kept is the list of message ids already
# handled (`mail-state.json` in the bridge folder). The app-specific password
# lives in the login Keychain, never in a file.

MAIL_CONFIG = HERE / "mail.config"
MAIL_STATE = BRIDGE / "mail-state.json"
MAIL_LABEL = "app.workflow.claude-mail"
MAIL_PLIST = Path.home() / "Library/LaunchAgents" / f"{MAIL_LABEL}.plist"
MAIL_SCRIPT = HERE / "claude-mail.sh"
MAIL_KEYCHAIN_SERVICE = "wf-mail"
MAIL_PREVIEW_LIMIT = 700


def _mail_config():
    if not MAIL_CONFIG.exists():
        die("mail isn't set up — run: wf mail setup you@icloud.com")
    return json.loads(MAIL_CONFIG.read_text())


def _mail_password(user):
    import subprocess
    r = subprocess.run(["security", "find-generic-password", "-s", MAIL_KEYCHAIN_SERVICE, "-a", user, "-w"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die("no password in the Keychain for that address — run: wf mail setup " + user)
    return r.stdout.strip()


def _mail_state():
    if MAIL_STATE.exists():
        try:
            return json.loads(MAIL_STATE.read_text())
        except json.JSONDecodeError:
            pass
    return {"handled": {}}


def _mail_save_state(state):
    # Keep it bounded: ids older than 90 days are dropped; UNSEEN messages
    # that old are a lost cause anyway.
    cutoff = time.time() - 90 * 86400
    state["handled"] = {k: v for k, v in state["handled"].items() if v >= cutoff}
    MAIL_STATE.write_text(json.dumps(state, indent=2))


def _decode_header(value):
    from email.header import decode_header, make_header
    try:
        return str(make_header(decode_header(value or ""))).strip()
    except Exception:
        return (value or "").strip()


def mail_parse(raw):
    """One IMAP message (possibly truncated) → the fields a task needs.
    Pure function: what claude-mail.sh gets, and what the tests cover."""
    import email
    from email import policy
    from email.utils import parsedate_to_datetime
    msg = email.message_from_bytes(raw, policy=policy.compat32)
    subject = _decode_header(msg.get("Subject"))
    sender = _decode_header(msg.get("From")).replace('"', "")
    msg_id = (msg.get("Message-ID") or "").strip()
    date = None
    try:
        date = parsedate_to_datetime(msg.get("Date")) if msg.get("Date") else None
    except Exception:
        date = None
    preview, html = None, None
    parts = msg.walk() if msg.is_multipart() else [msg]
    for part in parts:
        ctype = part.get_content_type()
        if ctype not in ("text/plain", "text/html"):
            continue
        try:
            payload = part.get_payload(decode=True) or b""
            charset = part.get_content_charset() or "utf-8"
            text = payload.decode(charset, errors="replace")
        except Exception:
            continue
        if ctype == "text/plain" and text.strip():
            preview = text
            break
        if ctype == "text/html" and html is None:
            import re as _re
            t = _re.sub(r"(?is)<style.*?</style>", "", text)
            t = _re.sub(r"(?i)<br\s*/?>|</p>|</div>|</li>|</tr>", "\n", t)
            t = _re.sub(r"<[^>]+>", "", t)
            html = (t.replace("&nbsp;", " ").replace("&amp;", "&").replace("&lt;", "<")
                     .replace("&gt;", ">").replace("&quot;", '"').replace("&#39;", "'"))
    text = (preview or html or "")
    import re as _re
    text = _re.sub(r"\n{3,}", "\n\n", text.replace("\r\n", "\n")).strip()
    if len(text) > MAIL_PREVIEW_LIMIT:
        text = text[:MAIL_PREVIEW_LIMIT].rstrip() + "…"
    link = None
    if msg_id:
        link = "message://%3C" + msg_id.strip("<>") + "%3E"
    return {
        "attachments": mail_attachment_names(msg),
        "id": msg_id or f"nomsgid:{sender}|{subject}|{msg.get('Date','')}",
        "subject": subject or "(no subject)",
        "from": sender,
        "date": date.isoformat(timespec="minutes") if date else None,
        "link": link,
        "preview": text,
    }


def mail_attachment_names(msg):
    """Names of the files a message carries, as far as the headers we have
    show them. From a truncated peek this can miss files whose part starts
    past the cut, so it is a hint for the listing, not an inventory."""
    names = []
    for part in (msg.walk() if msg.is_multipart() else [msg]):
        if part.is_multipart():
            continue
        disposition = (part.get("Content-Disposition") or "").lower()
        name = part.get_filename()
        if not name and not disposition.startswith("attachment"):
            continue
        if not disposition.startswith("attachment") and part.get("Content-ID") and part.get_content_maintype() == "image":
            continue   # an image the HTML body shows inline — a logo, mostly
        if part.get_content_type() in ("application/pkcs7-signature", "application/x-pkcs7-signature",
                                       "application/pgp-signature", "application/ms-tnef"):
            continue
        names.append(_decode_header(name) if name else "Attachment")
    return names


def mail_extract_attachments(raw):
    """Every file in a full message: [(name, bytes)]. Same rules as the app's
    MailAttachments (inline logos, signatures and TNEF wrappers are skipped;
    repeated names get a number)."""
    import email
    from email import policy
    msg = email.message_from_bytes(raw, policy=policy.compat32)
    out, seen = [], {}

    def leaves(part):
        # A forwarded message is one file, as in the app: kept whole as .eml,
        # never opened up into its own body and attachments.
        if part.get_content_type() == "message/rfc822" and part is not msg:
            yield part
        elif part.is_multipart():
            for child in part.get_payload():
                yield from leaves(child)
        else:
            yield part

    for part in leaves(msg):
        disposition = (part.get("Content-Disposition") or "").lower()
        name = part.get_filename()
        ctype = part.get_content_type()
        if ctype == "message/rfc822" and not name:
            name = "Forwarded message.eml"
        if not name and not disposition.startswith("attachment"):
            continue
        if not disposition.startswith("attachment") and part.get("Content-ID") and part.get_content_maintype() == "image":
            continue
        if ctype in ("application/pkcs7-signature", "application/x-pkcs7-signature",
                     "application/pgp-signature", "application/ms-tnef"):
            continue
        if ctype == "message/rfc822":
            inner = part.get_payload()
            data = (inner[0] if isinstance(inner, list) and inner else part).as_bytes()
        else:
            data = part.get_payload(decode=True)
        if not data or len(data) > 50 * 1024 * 1024:
            continue
        name = _decode_header(name) if name else "Attachment"
        name = name.replace("/", "-").replace(":", "-").strip().lstrip(".") or "Attachment"
        key = name.lower()
        if key in seen:
            seen[key] += 1
            stem, dot, ext = name.rpartition(".")
            name = f"{stem} ({seen[key]}).{ext}" if dot else f"{name} ({seen[key]})"
        else:
            seen[key] = 1
        out.append((name, data))
    return out


def mail_fetch_full(message_id):
    """One whole message by Message-ID, still read-only and PEEKed."""
    import imaplib
    cfg = _mail_config()
    user = cfg["user"]
    box = imaplib.IMAP4_SSL(cfg.get("host", "imap.mail.me.com"), 993)
    try:
        box.login(user, _mail_password(user))
        if box.select("INBOX", readonly=True)[0] != "OK":
            die("couldn't open INBOX")
        wanted = message_id if message_id.startswith("<") else f"<{message_id}>"
        status, data = box.search(None, "HEADER", "Message-ID", wanted)
        uids = data[0].split() if status == "OK" and data and data[0] else []
        if not uids:
            die(f"no message with id {message_id} in the inbox")
        status, parts = box.fetch(uids[-1], "(BODY.PEEK[])")
        if status != "OK" or not parts or not isinstance(parts[0], tuple):
            die("couldn't fetch the message")
        return parts[0][1]
    finally:
        try:
            box.logout()
        except Exception:
            pass


def mail_fetch_unread(limit=50):
    import imaplib
    cfg = _mail_config()
    user = cfg["user"]
    pw = _mail_password(user)
    box = imaplib.IMAP4_SSL(cfg.get("host", "imap.mail.me.com"), 993)
    try:
        box.login(user, pw)
        # readonly: the server never sets \Seen on FETCH, and STORE is refused.
        status, _ = box.select("INBOX", readonly=True)
        if status != "OK":
            die("couldn't open INBOX")
        status, data = box.search(None, "UNSEEN")
        if status != "OK":
            die("search failed")
        uids = data[0].split()
        uids = uids[-limit:] if limit else uids
        out = []
        for uid in uids:
            # PEEK: read without touching flags. First 24 KB is plenty for
            # headers and a preview; attachments never come down.
            status, parts = box.fetch(uid, "(BODY.PEEK[]<0.24576>)")
            if status != "OK" or not parts or not isinstance(parts[0], tuple):
                continue
            row = mail_parse(parts[0][1])
            row["seq"] = uid.decode()
            out.append(row)
        return out
    finally:
        try:
            box.logout()
        except Exception:
            pass


def cmd_mail(args):
    sub = getattr(args, "mail_cmd", None)
    if sub == "setup":
        import getpass, subprocess
        user = args.address
        pw = getpass.getpass("App-specific password for %s (from appleid.apple.com → Sign-In and Security → App-Specific Passwords): " % user)
        if not pw.strip():
            die("no password given")
        r = subprocess.run(["security", "add-generic-password", "-U", "-s", MAIL_KEYCHAIN_SERVICE, "-a", user,
                            "-l", "WorkFlow Agent Bridge — iCloud Mail (read-only)", "-w", pw.strip()],
                           capture_output=True, text=True)
        if r.returncode != 0:
            die("Keychain refused: " + r.stderr.strip())
        MAIL_CONFIG.write_text(json.dumps({"user": user, "host": args.host}, indent=2))
        print(f"stored in the login Keychain as service “{MAIL_KEYCHAIN_SERVICE}”; config {MAIL_CONFIG}")
        print("try:  wf mail            (lists unread, read-only)")
        return
    if sub == "mark":
        state = _mail_state()
        now = time.time()
        for mid in args.ids:
            state["handled"][mid] = now
        _mail_save_state(state)
        print(f"marked {len(args.ids)} handled")
        return
    if sub == "attach":
        # 5.0: an email's own files onto the task made from it.
        task = find_task(args.task)
        raw = mail_fetch_full(args.message_id)
        info = mail_parse(raw)
        files = mail_extract_attachments(raw)
        if not files:
            print("that message has no attachments")
            return
        ATTACHMENTS.mkdir(parents=True, exist_ok=True)
        summary = f"Attached to the email “{info['subject']}”" + (f", sent {info['date']}" if info.get("date") else "")
        for name, data in files:
            staged = ATTACHMENTS / name
            staged.write_bytes(data)
            send("attach_file", taskID=task["id"], fileName=name, docAuthor=info["from"] or None, docSummary=summary)
        return
    if sub == "install":
        mail_launchd_install(args)
        return
    if sub == "uninstall":
        os.system(f"launchctl bootout gui/$(id -u)/{MAIL_LABEL} 2>/dev/null")
        if MAIL_PLIST.exists():
            MAIL_PLIST.unlink()
        print("removed", MAIL_PLIST)
        return
    if sub == "status":
        print(f"config      {MAIL_CONFIG if MAIL_CONFIG.exists() else 'not set up'}")
        print(f"launchd     {'installed' if MAIL_PLIST.exists() else 'not installed'}")
        st = _mail_state()
        print(f"handled     {len(st['handled'])} message id(s) on file")
        return

    # default: list
    rows = mail_fetch_unread(limit=args.limit)
    if args.new:
        handled = _mail_state()["handled"]
        rows = [r for r in rows if r["id"] not in handled]
    if args.json:
        print(json.dumps({"messages": rows, "fetchedAt": datetime.now().isoformat(timespec="minutes")}, indent=2))
        return
    if not rows:
        print("no unread messages" + (" that aren't already handled" if args.new else ""))
        return
    for r in rows:
        clip = f"  📎 {len(r['attachments'])}" if r.get("attachments") else ""
        print(f"{(r['date'] or '')[:16]:16}  {r['from'][:34]:34}  {r['subject'][:60]}{clip}")
        if args.verbose and r["preview"]:
            print("    " + r["preview"].replace("\n", "\n    ")[:400])
            print("    id " + r["id"])


def mail_launchd_install(args):
    if not WAKE_CONFIG.exists():
        die("run `wf wake install` first — the mail runner shares its config")
    _mail_config()
    plist = {
        "Label": MAIL_LABEL,
        "ProgramArguments": ["/bin/bash", str(MAIL_SCRIPT)],
        "StartInterval": int(args.every) * 60,
        "RunAtLoad": False,
        "StandardErrorPath": str(Path.home() / "Library/Logs/claude-mail.log"),
    }
    MAIL_PLIST.parent.mkdir(parents=True, exist_ok=True)
    with open(MAIL_PLIST, "wb") as fh:
        plistlib.dump(plist, fh)
    os.system(f"launchctl bootout gui/$(id -u)/{MAIL_LABEL} 2>/dev/null")
    rc = os.system(f"launchctl bootstrap gui/$(id -u) {MAIL_PLIST} 2>/dev/null")
    print(f"installed  {MAIL_PLIST}  (every {args.every} min)")
    if rc != 0:
        print("launchctl bootstrap returned non-zero — check: launchctl print gui/$(id -u)/" + MAIL_LABEL)


# ---------------------------------------------------------------- email (4.9.4)
#
# `wf email` is how a task that says "email Jane about the quote" gets done.
# What it may do is the user's call, made in WorkFlow → Settings → Agent Bridge
# → Email and published in snapshot.json:
#
#   off    nothing — refuses, exit 2
#   draft  the message is filed on the task as an .eml draft; the user checks
#          it and sends it from their own Mail with Review & Send
#   send   `--send` may send it through the user's iCloud account (SMTP, the
#          same app-specific password `wf mail setup` keeps in the Keychain),
#          and a copy is filed on the task
#
# Even at `send`, a task is only ever drafted when it says "draft only"
# (title, notes, pinned note, or one of the user's comments), or when it was
# made from an incoming email — that email's words are a stranger's, and they
# must never be able to make anything leave this Mac. The app enforces the
# switch again on the `draft_email` it receives.

EMAIL_ADDRESS = re.compile(r"^[^@\s,;<>]+@[^@\s,;<>]+\.[^@\s,;<>]+$")


def email_permission(snapshot):
    return ((snapshot or {}).get("permissions") or {}).get("email", "off")


def email_draft_only_reason(task):
    if task.get("fromEmail"):
        return "this task was made from an incoming email, so it only ever gets a draft"
    texts = [task.get("title", ""), task.get("notes", ""), task.get("pinnedNote", "")]
    texts += [c.get("text", "") for c in task.get("comments", [])
              if c.get("authorID") != AGENT_AUTHOR_ID and c.get("author") != AGENT_NAME]
    if any(re.search(r"\bdraft[\s-]+only\b", t or "", re.I) for t in texts):
        return "the task says “draft only”"
    return None


def smtp_send(to, cc, subject, body):
    import smtplib, ssl
    from email.message import EmailMessage
    from email.utils import formatdate, make_msgid
    cfg = _mail_config()
    user = cfg["user"]
    msg = EmailMessage()
    msg["From"] = cfg.get("from", user)
    msg["To"] = ", ".join(to)
    if cc:
        msg["Cc"] = ", ".join(cc)
    msg["Subject"] = subject
    msg["Date"] = formatdate(localtime=True)
    msg["Message-ID"] = make_msgid(domain=user.split("@")[-1])
    msg.set_content(body)
    host = cfg.get("smtp_host", "smtp.mail.me.com")
    with smtplib.SMTP(host, 587, timeout=30) as s:
        s.starttls(context=ssl.create_default_context())
        s.login(user, _mail_password(user))
        s.send_message(msg)


def cmd_email(args):
    snapshot = load_snapshot()
    level = email_permission(snapshot)
    if snapshot is not None and "permissions" not in snapshot:
        die("this WorkFlow predates email permissions — update it to 4.9.4 or later", 2)
    if level == "off":
        die("email is switched off — WorkFlow → Settings → Agent Bridge → Email", 2)
    task = find_task(args.task)
    to = [a.strip() for a in args.to if a.strip()]
    cc = [a.strip() for a in (args.cc or []) if a.strip()]
    for a in to + cc:
        if not EMAIL_ADDRESS.match(a):
            die(f"“{a}” isn't a single email address")
    subject = args.subject.strip()
    if not subject or "\n" in subject or "\r" in subject:
        die("need a one-line --subject")
    body = Path(args.body_file).expanduser().read_text() if args.body_file else (args.body or "")
    if not body.strip():
        die("need --body or --body-file")

    send_it = args.send
    if send_it and level != "send":
        print("wf: email is set to Draft Only — filing a draft instead", file=sys.stderr)
        send_it = False
    if send_it:
        reason = email_draft_only_reason(task)
        if reason:
            print(f"wf: {reason} — filing a draft instead", file=sys.stderr)
            send_it = False

    if send_it:
        try:
            smtp_send(to, cc, subject, body)
        except Exception as e:  # nothing is recorded as sent unless it was
            die(f"sending failed, nothing was sent: {e}\n     re-run without --send to file a draft", 2)
        print(f"sent to {', '.join(to + cc)}")
    send("draft_email", taskID=task["id"], emailTo=to, emailCc=cc or None,
         emailSubject=subject, emailBody=body, emailSent=True if send_it else None)


