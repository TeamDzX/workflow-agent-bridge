        return agenda_launchd(args)
    buckets, alerts = _agenda(args.days)
    counts = {k: len(v) for k, v in buckets.items()}

    if args.json:
        payload = {
            "generatedAt": datetime.now().astimezone().isoformat(),
            "horizonDays": args.days,
            "counts": counts,
            "alerts": len(alerts),
            "tasks": {
                k: [{"id": t["id"], "title": t["title"], "project": t["project"],
                     "priority": t["priority"], "assignee": t["assignee"],
                     "due": t["due"].isoformat() if t["due"] and t["hasDue"] else None,
                     "hasReminder": t.get("hasReminder"),
                     "inMyDay": t["inMyDay"]}
                    for t in v]
                for k, v in buckets.items()
            },
        }
        print(json.dumps(payload, indent=2))
        return

    text = _agenda_text(buckets, alerts, args.days, limit=args.limit)
    print(text)
    if args.post:
