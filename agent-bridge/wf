import getpass
import json
import os
import plistlib
import re
import sqlite3
import sys
import time
import uuid
from datetime import datetime, timezone, timedelta
from pathlib import Path

# The Mac app's own container. WF_CONTAINER overrides it — useful against a
# simulator install, or a second copy of the app.
CONTAINER = Path(
    os.environ.get(
        "WF_CONTAINER",
        Path.home() / "Library/Containers/mac.TeamDZX.worflow/Data/Library/Application Support",
    )
)

AGENT_AUTHOR_ID = "agent.claude"
AGENT_NAME = "Claude"
NOTE_MARKER = "@claude"

# Resolved once. There is a symlink to the repo on the Desktop for convenience,
# and macOS keeps background processes out of the Desktop — so every path this
# tool bakes into launchd config must be the real one, never the path it
# happened to be invoked through.
HERE = Path(__file__).resolve().parent
WORKSPACE_PACK = HERE / "claude-workspace.json"

# Core Data stores seconds since 2001-01-01, not the Unix epoch.
APPLE_EPOCH_OFFSET = 978307200
EPOCH = datetime.min.replace(tzinfo=timezone.utc)


def resolve_bridge():
    explicit = os.environ.get("WF_BRIDGE")
    if explicit:
        return Path(explicit)
    pointer = CONTAINER / "AgentBridge" / "location.json"
    try:
        root = json.loads(pointer.read_text()).get("root")
        if root and Path(root).is_dir():
            return Path(root)
    except (OSError, ValueError):
        pass
    return CONTAINER / "AgentBridge"


BRIDGE = resolve_bridge()
INBOX, OUTBOX = BRIDGE / "inbox", BRIDGE / "outbox"
ATTACHMENTS = BRIDGE / "attachments"
STATE, SNAPSHOT = BRIDGE / "state.json", BRIDGE / "snapshot.json"
WATERMARK = BRIDGE / ".wf-watermark"


def die(msg, code=1):
    print(f"wf: {msg}", file=sys.stderr)
    sys.exit(code)


def read_state():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


# ------------------------------------------------------------------ reading

def parse_iso(value):
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def apple_time(seconds):
    if seconds is None:
        return None
    return datetime.fromtimestamp(seconds + APPLE_EPOCH_OFFSET, tz=timezone.utc)


def uuid_str(value):
    """ZID is a 16-byte BLOB, not text — Core Data stores UUIDs raw."""
    if value is None:
        return None
    if isinstance(value, (bytes, bytearray)):
        try:
            return str(uuid.UUID(bytes=bytes(value)))
        except ValueError:
            return None
    return str(value)


def load_snapshot():
    try:
        return json.loads(SNAPSHOT.read_text())
    except (OSError, ValueError):
        return None


def live_store():
    """Which store the app actually opened — the fallback when there's no
    snapshot. state.json says so outright when the bridge is on; otherwise
    the most recently written store file, because this Mac runs on
    freshStore.store rather than default.store."""
    path = read_state().get("storePath")
    if path and Path(path).exists():
        return Path(path)
    candidates = []
    for store in CONTAINER.glob("*.store"):
        wal = store.with_name(store.name + "-wal")
        mtime = max(store.stat().st_mtime, wal.stat().st_mtime if wal.exists() else 0)
        candidates.append((mtime, store))
    if not candidates:
        die("no snapshot in the bridge folder and no SwiftData store under "
            f"{CONTAINER}\n     Is WorkFlow running with Settings > Agent Bridge on?")
    return max(candidates)[1]


def query(sql, params=()):
    uri = f"file:{live_store()}?mode=ro"
    try:
        conn = sqlite3.connect(uri, uri=True)
    except sqlite3.OperationalError as exc:
        die(f"couldn't open the store ({exc}). A background session can't reach "
            "the app's container — choose a Bridge Folder in WorkFlow's Settings "
            "so the app writes snapshot.json somewhere readable.")
    try:
        conn.row_factory = sqlite3.Row
        return conn.execute(sql, params).fetchall()
    finally:
        conn.close()


def _blob_json(blob):
    if not blob:
        return []
    try:
        return json.loads(bytes(blob).decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        return []


def _comment(c, ts):
    return {"id": c.get("id"), "author": c.get("author", "?"), "authorID": c.get("authorID"),
            "text": c.get("text", ""), "ts": ts}


def all_tasks(include_hidden=False):
    """Every task as a plain dict, from the snapshot if there is one."""
    snap = load_snapshot()
    rows = []
    if snap is not None:
        for t in snap.get("tasks", []):
            if not include_hidden and t.get("isHidden"):
                continue
            rows.append({
                "id": (t.get("id") or "").lower(),
                "title": t.get("title", ""),
                "status": t.get("status", ""),
                "priority": t.get("priority", ""),
                "project": t.get("project", ""),
                "assignee": t.get("assignee", ""),
                "due": parse_iso(t.get("dueDate")),
                # 4.7 and later. An older app writes neither, so `hasDueDate`
                # defaults to True (every task was dated before 4.7) and
                # `hasReminder` to None, which reads as "this snapshot can't
                # say" rather than "no alert".
                "hasDue": t.get("hasDueDate", True),
                "hasReminder": t.get("hasReminder"),
                "snoozed": bool(t.get("isSnoozed")),
                "inMyDay": bool(t.get("isInMyDay")),
                "updated": parse_iso(t.get("updatedAt")),
                "pinnedNote": t.get("pinnedNote", ""),
                "notes": t.get("notes", ""),
                "subtasks": t.get("subtasks", []),
                "comments": sorted((_comment(c, parse_iso(c.get("timestamp")))
                                    for c in t.get("comments", [])),
                                   key=lambda c: c["ts"] or EPOCH),
            })
    else:
        clause = "" if include_hidden else "WHERE ZISMINIMIZED = 0 AND ZARCHIVEDAT IS NULL"
        for r in query(f"SELECT ZID, ZTITLE, ZSTATUS, ZPRIORITY, ZPROJECT, ZASSIGNEE, ZDUEDATE, "
                       f"ZUPDATEDAT, ZPINNEDNOTE, ZSTRIPPEDNOTES, ZNOTES, ZSUBTASKSDATA, "
                       f"ZCOMMENTSDATA FROM ZPMTASK {clause}"):
            rows.append({
                "id": (uuid_str(r["ZID"]) or "").lower(),
                "title": r["ZTITLE"] or "",
                "status": r["ZSTATUS"] or "",
                "priority": r["ZPRIORITY"] or "",
                "hasDue": True,
                "hasReminder": None,
                "snoozed": False,
                "inMyDay": False,
                "project": r["ZPROJECT"] or "",
                "assignee": r["ZASSIGNEE"] or "",
                "due": apple_time(r["ZDUEDATE"]),
                "updated": apple_time(r["ZUPDATEDAT"]),
                "pinnedNote": r["ZPINNEDNOTE"] or "",
                "notes": r["ZSTRIPPEDNOTES"] or r["ZNOTES"] or "",
                "subtasks": _blob_json(r["ZSUBTASKSDATA"]),
                "comments": sorted((_comment(c, apple_time(c.get("timestamp")))
                                    for c in _blob_json(r["ZCOMMENTSDATA"])),
                                   key=lambda c: c["ts"] or EPOCH),
            })
    return sorted(rows, key=lambda r: r["updated"] or EPOCH, reverse=True)


def all_notes(include_archived=False):
    snap = load_snapshot()
    rows = []
    if snap is not None:
        for n in snap.get("notes", []):
            if not include_archived and n.get("isArchived"):
                continue
            rows.append({
                "id": (n.get("id") or "").lower(),
                "title": n.get("title", ""), "body": n.get("body", ""),
                "isPinned": bool(n.get("isPinned")), "isArchived": bool(n.get("isArchived")),
                "convertedAt": parse_iso(n.get("convertedAt")),
                "convertedTargetName": n.get("convertedTargetName", ""),
                "updated": parse_iso(n.get("updatedAt")),
            })
    else:
        clause = "" if include_archived else "WHERE ZISARCHIVED = 0"
        for r in query(f"SELECT ZID, ZTITLE, ZBODY, ZISPINNED, ZISARCHIVED, ZCONVERTEDAT, "
                       f"ZCONVERTEDTARGETNAME, ZUPDATEDAT FROM ZPMNOTE {clause}"):
            rows.append({
                "id": (uuid_str(r["ZID"]) or "").lower(),
                "title": r["ZTITLE"] or "", "body": r["ZBODY"] or "",
                "isPinned": bool(r["ZISPINNED"]), "isArchived": bool(r["ZISARCHIVED"]),
                "convertedAt": apple_time(r["ZCONVERTEDAT"]),
                "convertedTargetName": r["ZCONVERTEDTARGETNAME"] or "",
                "updated": apple_time(r["ZUPDATEDAT"]),
            })
    return sorted(rows, key=lambda r: (not r["isPinned"], -(r["updated"] or EPOCH).timestamp()))


def _find(rows, needle, kind, haystack):
    try:
        wanted = str(uuid.UUID(needle)).lower()
        for row in rows:
            if row["id"] == wanted:
                return row
        die(f"no {kind} with id {needle}")
    except ValueError:
        pass
    matches = [r for r in rows if needle.lower() in haystack(r).lower()]
    if not matches:
        die(f'no active {kind} matching "{needle}"')
    if len(matches) > 1:
        print(f'wf: "{needle}" matched {len(matches)} {kind}s, using the most recent:', file=sys.stderr)
        for row in matches[:5]:
            print(f"      {row['title']}", file=sys.stderr)
    return matches[0]


def find_task(needle):
    """A UUID matches exactly; anything else matches a title fragment."""
    return _find(all_tasks(), needle, "task", lambda r: r["title"])


def find_note(needle):
    return _find(all_notes(), needle, "note", lambda r: r["title"] + " " + r["body"])


def note_title(row):
    """Mirrors PMNote.displayTitle: fall back to the first body line."""
    title = (row["title"] or "").strip()
    if title:
        return title
    for line in (row["body"] or "").splitlines():
        if line.strip():
            return line.strip()[:60]
    return "Untitled note"


def local(dt):
    return dt.astimezone() if dt else None


# ------------------------------------------------------------------ writing

def send(op, wait=True, **fields):
    if not INBOX.exists():
        die(f"inbox not found at {INBOX}\n"
            "     Turn on WorkFlow > Settings > Agent Bridge.")
    command = {"id": f"wf-{int(time.time() * 1000)}-{uuid.uuid4().hex[:6]}", "op": op}
    command.update({k: v for k, v in fields.items() if v is not None})

    # Atomic: the app skips a half-written file for 5s, then calls it malformed.
    tmp = INBOX / f".{command['id']}.tmp"
    tmp.write_text(json.dumps(command, indent=2))
    tmp.rename(INBOX / f"{command['id']}.json")

    if not wait:
        print(command["id"])
        return None

    receipt_path = OUTBOX / f"{command['id']}.json"
    deadline = time.time() + 30
    while time.time() < deadline:
        if receipt_path.exists():
            try:
                receipt = json.loads(receipt_path.read_text())
            except ValueError:
                time.sleep(0.2)
                continue
            status = receipt.get("status", "?")
            message = receipt.get("message", "")
            marker = "ok" if status == "applied" else status
            print(f"[{marker}] {message}")
            if receipt.get("taskID"):
                print(f"       task {receipt['taskID']}")
            if status != "applied":
                sys.exit(2)
            wait_for_snapshot(after=receipt_path.stat().st_mtime)
            return receipt
        time.sleep(0.25)
    die("timed out after 30s — is WorkFlow running with the bridge switched on?", 3)


def wait_for_snapshot(after, timeout=6.0):
    """Read-your-writes. The app rewrites snapshot.json about two seconds after
    it applies a command, so a read straight after a write would see the old
    world — `wf add X && wf attach X` failed on exactly that. Block until the
    snapshot is newer than the receipt, or give up quietly and let the reader
    take its chances."""
    if not SNAPSHOT.exists():
        return
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            if SNAPSHOT.stat().st_mtime > after:
                return
        except OSError:
            return
        time.sleep(0.2)


# ---------------------------------------------------------------- commands

def cmd_state(args):
    state = read_state()
    if not state:
        print(f"Bridge has never been enabled (no {STATE}).")
    else:
        print(f"enabled     {state.get('enabled')}")
        print(f"app         {state.get('appVersion')} ({state.get('build')})")
        print(f"folder      {state.get('root')}"
              f"{'' if state.get('folderChosen') else '   (inside the app — choose a Bridge Folder to run unattended)'}")
        print(f"last action {state.get('lastActivityAt', '—')}")
        print(f"ops         {', '.join(state.get('ops', []))}")
    snap = load_snapshot()
    if snap:
        generated = parse_iso(snap.get("generatedAt")) or datetime.now(timezone.utc)
        age = int((datetime.now(timezone.utc) - generated).total_seconds())
        print(f"snapshot    {len(snap.get('tasks', []))} tasks, {len(snap.get('notes', []))} notes, {age}s old")
    else:
        print("snapshot    none — reads fall back to the store (interactive only)")


def cmd_tasks(args):
    rows = all_tasks(include_hidden=args.all)
    if not rows:
        print("No tasks.")
        return
    for row in rows:
        bits = [f"{(row['status'] or '?'):<12}", f"{row['title'][:46]:<46}"]
        if row["project"]:
            bits.append(f"[{row['project']}]")
        if row["due"]:
            bits.append(local(row["due"]).strftime("due %Y-%m-%d"))
        print("  ".join(bits))
        print(f"    {row['id']}")


def print_thread(comments):
    if not comments:
        print("\nNo comments.")
        return
    print(f"\n{len(comments)} comment(s):")
    for c in comments:
        stamp = local(c["ts"]).strftime("%Y-%m-%d %H:%M") if c["ts"] else "?"
        print(f"\n  {c['author']} · {stamp}")
        for line in (c["text"] or "").splitlines() or [""]:
            print(f"    {line}")


def cmd_show(args):
    task = find_task(args.task)
    print(f"{task['title']}  ({task['status']})")
    print(f"id {task['id']}")
    if task["pinnedNote"]:
        print(f"status: {task['pinnedNote']}")
    for item in task["subtasks"]:
        print(f"  [{'x' if item.get('isCompleted') else ' '}] {item.get('title', '')}")
    print_thread(task["comments"])


def cmd_queue(args):
    """The agent's inbox: tasks whose assignee is the agent — the app's own
    ownership field, so you assign from the phone exactly as you'd assign to
    a person, and My Work already renders the mirror image."""
    rows = [r for r in all_tasks()
            if r["assignee"].lower() == AGENT_NAME.lower() and r["status"] != "Completed"]
    rows.sort(key=lambda r: r["due"] or datetime.max.replace(tzinfo=timezone.utc))
    if not rows:
        print(f"Nothing assigned to {AGENT_NAME}.")
        sys.exit(1)
    for row in rows:
        head = f"{row['title']}  [{row['status']}"
        if row["priority"]:
            head += f", {row['priority']}"
        head += "]"
        if row["due"]:
            head += f"  due {local(row['due']):%Y-%m-%d}"
        print(head)
        print(f"  {row['id']}")
        if row["pinnedNote"]:
            print(f"  status: {row['pinnedNote']}")
        for item in row["subtasks"]:
            print(f"    [{'x' if item.get('isCompleted') else ' '}] {item.get('title', '')}")
        if row["comments"]:
            last = row["comments"][-1]
            print(f"  last: {last['author']} — {(last['text'] or '')[:90]}")
        print()
    sys.exit(0)


def cmd_poll(args):
    """Comments the user has left since the last poll. Cheap by design: one
    read on the ticks where nothing happened, and an exit code (1 = nothing)
    a loop can branch on."""
    since = args.since
    if since is None and WATERMARK.exists():
        since = WATERMARK.read_text().strip() or None
    cutoff = parse_iso(since) if since else None
    if since and cutoff is None:
        die(f"couldn't read --since {since!r}; expected ISO-8601")
    cutoff = cutoff or EPOCH

    found, newest = [], cutoff
    for row in all_tasks():
        for c in row["comments"]:
            ts = c["ts"]
            if not ts:
                continue
            if ts > newest:
                newest = ts
            if ts <= cutoff or c["authorID"] == AGENT_AUTHOR_ID:
                continue
            found.append((ts, row, c))

    for ts, row, c in sorted(found, key=lambda item: item[0]):
        print(f"{row['title']}  ·  {c['author']}  ·  {local(ts):%Y-%m-%d %H:%M}")
        print(f"  {c['text']}")
        print(f"  reply: wf comment {row['id']} '...'")
        print()

    if not found:
        print("Nothing new.")
    if newest > cutoff:
        BRIDGE.mkdir(parents=True, exist_ok=True)
        WATERMARK.write_text(newest.isoformat())
    sys.exit(0 if found else 1)


def cmd_check(args):
    task = find_task(args.task)
    key = "uncheckSubtasks" if args.uncheck else "checkSubtasks"
    send("update_task", **{"taskID": task["id"], key: args.subtask})


def cmd_rename(args):
    task = find_task(args.task)
    send("update_task", taskID=task["id"], renameSubtasks=[{"from": args.old, "to": args.new}])


def cmd_edit(args):
    """Change an existing task. Only the fields given are touched."""
    task = find_task(args.task)
    notes = Path(args.notes_file).expanduser().read_text() if args.notes_file else args.notes
    fields = dict(title=args.title, notes=notes, appendNotes=args.append_notes,
                  priority=args.priority, status=args.status, assignee=args.assignee,
                  project=args.project, addTags=args.add_tag, removeTags=args.remove_tag,
                  isInMyDay=args.my_day)
    if all(v is None for v in fields.values()):
        die("nothing to change — see wf edit --help")
    send("update_task", taskID=task["id"], **fields)


def cmd_subtask(args):
    task = find_task(args.task)
    key = {"add": "addSubtasks", "remove": "removeSubtasks"}[args.action]
    send("update_task", **{"taskID": task["id"], key: args.items})


def cmd_status(args):
    task = find_task(args.task)
    send("update_task", taskID=task["id"], pinnedNote=args.text)


# ------------------------------------------------------------------- agenda

AGENDA_BUCKETS = ("overdue", "today", "soon", "upcoming", "undated")


def _agenda(days=7):
    """The same buckets the app's Dashboard shows, from the same snapshot the
    app writes — so a person and an agent read one source, not two.

    Completed, hidden and snoozed tasks are out: a snoozed task has been
    explicitly pushed out of sight, and listing it in a digest undoes the one
    thing the user asked for.
    """
    today = datetime.now().astimezone().date()
    horizon = today + timedelta(days=days)
    out = {k: [] for k in AGENDA_BUCKETS}
    alerts = []
    for t in all_tasks():
        if t["status"] == "Completed" or t["snoozed"]:
            continue
        if t.get("hasReminder"):
            alerts.append(t)
        if not t["hasDue"]:
            out["undated"].append(t)
            continue
        if not t["due"]:
            continue
        d = local(t["due"]).date()
        if d < today:
            out["overdue"].append(t)
        elif d == today:
            out["today"].append(t)
        elif d <= horizon:
            out["soon"].append(t)
        else:
            out["upcoming"].append(t)
    for k in out:
        out[k].sort(key=lambda r: (r["due"] or EPOCH, r["title"].lower()))
    alerts.sort(key=lambda r: (r["due"] or EPOCH))
    return out, alerts


def _agenda_line(t):
    when = local(t["due"]).strftime("%-d %b") if t["due"] and t["hasDue"] else "no date"
    where = t["project"] or "no project"
    bell = " 🔔" if t.get("hasReminder") else ""
    return f"{t['title']}  ·  {where}  ·  {when}{bell}"


