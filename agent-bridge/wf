def cmd_attach(args):
    """Stage the file inside the bridge folder, then ask the app to take it.

    The app is sandboxed and can only open files inside its own container or
    the chosen bridge folder, so a file anywhere else has to be copied in
    first. The app deletes the staged copy once the bytes are in the store.
    """
    import shutil
    src = Path(args.file).expanduser()
    if not src.is_file():
        die(f"no such file: {src}")
    task = find_task(args.task)
    ATTACHMENTS.mkdir(parents=True, exist_ok=True)
    staged = ATTACHMENTS / src.name
    # A source already inside attachments/ is fine — just use it.
    if Path(src).resolve() != staged.resolve():
        shutil.copyfile(src, staged)
    send("attach_file", taskID=task["id"], fileName=src.name, displayName=args.name)


# ---------------------------------------------------------------- documents (5.0)
#
# Documents are every file in WorkFlow — on a task, on a note, or filed into a
# project's workspace — each with a number ("WF-4F2A91"), a profile (type,
# status, author, description, folder) and a version history. These commands
# read them from the snapshot and change them through the app.

def all_documents():
    snap = load_snapshot()
    if snap is None or "documents" not in snap:
        die("no documents in the snapshot — this needs WorkFlow 5.0 with the bridge on")
    return snap["documents"]


def find_document(needle):
    rows = all_documents()
    n = needle.strip().lower()
    for key in ("id", "number"):
        hit = [r for r in rows if r.get(key, "").lower() == n or
               (key == "id" and any(v.get("id", "").lower() == n for v in r.get("versions", [])))]
        if hit:
            return hit[0]
    exact = [r for r in rows if r.get("name", "").lower() == n]
    if exact:
        return exact[0]
    partial = [r for r in rows if n in r.get("name", "").lower()]
    if not partial:
        die(f'no document matching "{needle}" — try a number like WF-4F2A91, or wf docs')
    if len(partial) > 1:
        print(f'wf: "{needle}" matched {len(partial)} documents, using the most recent:', file=sys.stderr)
        for r in partial[:5]:
            print(f"       {r['number']}  {r['name']}", file=sys.stderr)
    return sorted(partial, key=lambda r: r.get("updatedAt", ""), reverse=True)[0]


def document_line(d):
    bits = [f"{d['number']} v{d['version']}", d["name"]]
    if d.get("type"):
        bits.append(f"[{d['type']}]")
    if d.get("status"):
        bits.append(f"({d['status']})")
    where = d.get("task") or (f"workspace {d['project']}" if d.get("inWorkspace") else "note")
    if d.get("folder"):
        where += f" / {d['folder']}"
    return "  ".join(bits) + f"  — {where}"


def cmd_docs(args):
    rows = all_documents()
    q = (args.query or "").lower()
    def hit(d):
        if args.project and d.get("project", "").lower() != args.project.lower():
            return False
        if args.type and d.get("type", "").lower() != args.type.lower():
            return False
        if args.status and d.get("status", "").lower() != args.status.lower():
            return False
        if not q:
            return True
        fields = [d.get(k, "") for k in ("number", "name", "type", "status", "author", "description",
                                         "folder", "project", "task", "text")]
        return any(q in (f or "").lower() for f in fields)
    rows = sorted((d for d in rows if hit(d)), key=lambda d: d.get("updatedAt", ""), reverse=True)
    if args.json:
        print(json.dumps(rows, indent=2))
        return
    if not rows:
        print("no documents match")
        sys.exit(1)
    for d in rows[: args.limit]:
        print(document_line(d))
    if len(rows) > args.limit:
        print(f"… and {len(rows) - args.limit} more (--limit)")


