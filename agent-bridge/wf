def _stage_and_attach(task, path):
    """Copy a file into the bridge's attachments/ and hand it to the app.
    Returns the display name used."""
    import shutil
    src = Path(path).expanduser()
    if not src.is_file():
        die(f"no such file: {src}")
    ATTACHMENTS.mkdir(parents=True, exist_ok=True)
    staged = ATTACHMENTS / src.name
    if src.resolve() != staged.resolve():
        shutil.copyfile(src, staged)
    send("attach_file", taskID=task["id"], fileName=src.name)
    return src


def _week_sessions(days=7):
    """Sessions active in the last N days, by working folder, from the
    transcripts under ~/.claude/projects. Symlinked project dirs (Developer/
    WorkFlow -> Desktop/WorkFlow) are deduped on the resolved path."""
    root = Path.home() / ".claude/projects"
    cutoff = time.time() - days * 86400
    seen, counts = set(), {}
    for d in root.iterdir():
        if not d.is_dir():
            continue
        real = d.resolve()
        if real in seen:
            continue
        seen.add(real)
        name = d.name
        for prefix in ("-Users-alex-Desktop-", "-Users-alex-Developer-", "-Users-alex-Projects-", "-Users-alex-"):
            if name.startswith(prefix):
                name = name[len(prefix):]
                break
        if name == "-Users-alex-Desktop":
            name = "Desktop"
        name = name.replace("---", " - ").replace("-", " ") or "Desktop"
        n = sum(1 for f in d.glob("*.jsonl") if f.stat().st_mtime >= cutoff)
        if n:
            counts[name] = counts.get(name, 0) + n
    # Prefer the exact title of an existing session task where one matches.
    titles = {r["title"].lower().replace("-", " "): r["title"] for r in _session_rows()}
    return {titles.get(k.lower(), k): v for k, v in counts.items()}



def _session_name(explicit):
    """The task title for a working folder. Path.cwd() resolves symlinks, so
    ~/Desktop/WorkFlow -> ~/Developer/WorkFlow both give "WorkFlow"."""
    name = (explicit or Path.cwd().name).strip()
    return SESSION_ALIASES.get(name.lower(), name)


