def _stage_and_attach(task, path):
    """Copy a file into the bridge's attachments/ and hand it to the app.
    Returns the display name used."""
    import shutil
    src = Path(path).expanduser()
    if not src.is_file():
        die(f"no such file: {src}")
    ATTACHMENTS.mkdir(parents=True, exist_ok=True)
    staged = ATTACHMENTS / src.name
    if src.resolve() != staged.resolve():
        shutil.copyfile(src, staged)
    send("attach_file", taskID=task["id"], fileName=src.name)
    return src


def _week_sessions(days=7):
    """Sessions active in the last N days, by working folder, from the
    transcripts under ~/.claude/projects. Symlinked project dirs (Developer/
    WorkFlow -> Desktop/WorkFlow) are deduped on the resolved path."""
    root = Path.home() / ".claude/projects"
    cutoff = time.time() - days * 86400
    seen, counts = set(), {}
    for d in root.iterdir():
        if not d.is_dir():
            continue
        real = d.resolve()
        if real in seen:
            continue
        seen.add(real)
        name = d.name
        home = "-" + str(Path.home()).strip("/").replace("/", "-")
        for prefix in (home + "-Desktop-", home + "-Developer-", home + "-Projects-", home + "-"):
            if name.startswith(prefix):
                name = name[len(prefix):]
                break
        if name == home + "-Desktop":
            name = "Desktop"
        name = name.replace("---", " - ").replace("-", " ") or "Desktop"
        n = sum(1 for f in d.glob("*.jsonl") if f.stat().st_mtime >= cutoff)
        if n:
            counts[name] = counts.get(name, 0) + n
    # Prefer the exact title of an existing session task where one matches.
    titles = {r["title"].lower().replace("-", " "): r["title"] for r in _session_rows()}
    return {titles.get(k.lower(), k): v for k, v in counts.items()}



def _session_name(explicit):
    """The task title for a working folder. Path.cwd() resolves symlinks, so
    ~/Desktop/WorkFlow -> ~/Developer/WorkFlow both give "WorkFlow"."""
    name = (explicit or Path.cwd().name).strip()
    return SESSION_ALIASES.get(name.lower(), name)


def _session_rows():
    return [r for r in all_tasks(include_hidden=True)
            if (r["project"] or "").lower() == SESSIONS_PROJECT.lower()]


def _session_task(title):
    for r in _session_rows():
        if r["title"].lower() == title.lower():
            return r
    return None


def cmd_session(args):
    if args.list:
        rows = sorted(_session_rows(), key=lambda r: r["title"].lower())
        if not rows:
            print(f"No tasks in {SESSIONS_PROJECT}.")
            return
        for r in rows:
            last = r["comments"][-1]["ts"] if r["comments"] else None
            stamp = local(last).strftime("%Y-%m-%d") if last else "never"
            print(f"{r['title']:<22} last session {stamp}  ·  {r['pinnedNote'][:90]}")
        return

    if args.weekly:
        counts = _week_sessions()
        total = sum(counts.values())
        parts = ", ".join(f"{k} {v}" for k, v in sorted(counts.items(), key=lambda kv: -kv[1]))
        line = (f"Week to {datetime.now():%-d %b %Y}: {total} session(s) active — {parts}."
                if total else f"Week to {datetime.now():%-d %b %Y}: no sessions.")
        print(line)
        send("add_comment", taskID=_housekeeping()["id"], text=line)
        return

    title = _session_name(args.codebase)
    writing = any([args.log, args.state, args.open, args.close, args.attach])
    task = _session_task(title)

    if task is None:
        if not writing:
            print(f"No session log for “{title}” yet in {SESSIONS_PROJECT}.\n"
                  f"Start one with: wf session {title!r} --log \"...\" [--state \"...\"]")
            return
        send("create_task", title=title, project=SESSIONS_PROJECT,
             notes=SESSIONS_HANDS_OFF, tags=["claude-log"],
             dueDate=SESSIONS_PARKED_DUE, hasDueDate=False,
             pinnedNote=args.state or f"First session {datetime.now():%Y-%m-%d}. No state written yet.",
             subtasks=args.open or None,
             text=args.log)
        return

    if not writing:
        print(f"{task['title']}  ·  {SESSIONS_PROJECT}")
        print(f"state: {task['pinnedNote'] or '(none)'}")
        if task["notes"] and task["notes"] != SESSIONS_HANDS_OFF:
            print()
            for line in task["notes"].splitlines():
                print(f"  {line}")
        open_loops = [i for i in task["subtasks"] if not i.get("isCompleted")]
        if open_loops:
            print("\nopen loops:")
            for i in open_loops:
                print(f"  [ ] {i.get('title', '')}")
        comments = task["comments"] if args.all else task["comments"][-3:]
        if comments and not args.all and len(task["comments"]) > 3:
            print(f"\n(last 3 of {len(task['comments'])} sessions — --all for the rest)")
        print_thread(comments)
        return

    fields = {}
    if args.state:
        fields["pinnedNote"] = args.state
    if args.open:
        fields["addSubtasks"] = args.open
    if args.close:
        fields["checkSubtasks"] = args.close
    if fields:
        send("update_task", taskID=task["id"], **fields)

    # Evidence: the file goes on the task (this one, or --to another), and the
    # comment says what it is and where the original lives, so it can be found
    # again without knowing the folder.
    attached = []
    if args.attach:
        target = find_task(args.to) if args.to else task
        for path in args.attach:
            src = _stage_and_attach(target, path)
            attached.append(f"{src.name}  (from {src})")
    text = args.log or ""
    if attached:
        where = f" on “{args.to}”" if args.to else ""
        text = (text + "\n\n" if text else "") + f"Attached{where}:\n" + "\n".join(f"• {a}" for a in attached)
    if text:
        send("add_comment", taskID=task["id"], text=text)


