def agenda_launchd(args):
    if args.action == "status":
        print(f"launchd agent   {'installed' if AGENDA_PLIST.exists() else 'not installed'}")
        if AGENDA_PLIST.exists():
            out = os.popen(f"launchctl list 2>/dev/null | grep {AGENDA_LABEL}").read().strip()
            print(f"loaded          {'yes' if out else 'no'}")
            print(f"plist           {AGENDA_PLIST}")
        return
    if args.action == "uninstall":
        os.system(f"launchctl bootout gui/$(id -u)/{AGENDA_LABEL} 2>/dev/null")
        if AGENDA_PLIST.exists():
            AGENDA_PLIST.unlink()
        print("Morning agenda removed.")
        return
    if not WAKE_CONFIG.exists():
        die("run `wf wake install` first — the agenda shares its config (bridge folder, claude path).")
    hour, minute = (args.at or "08:00").split(":")
