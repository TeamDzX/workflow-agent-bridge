    p.add_argument("--priority", choices=["High", "Medium", "Low"])
    p.add_argument("--due", help="ISO-8601 or yyyy-MM-dd")
    p.add_argument("--assignee", help=f"default: {AGENT_NAME}")
    p.add_argument("--subtask", action="append", help="repeatable")
