            return
        for r in rows:
            last = r["comments"][-1]["ts"] if r["comments"] else None
            stamp = local(last).strftime("%Y-%m-%d") if last else "never"
            print(f"{r['title']:<22} last session {stamp}  ·  {r['pinnedNote'][:90]}")
        return

    if args.weekly:
        counts = _week_sessions()
        total = sum(counts.values())
        parts = ", ".join(f"{k} {v}" for k, v in sorted(counts.items(), key=lambda kv: -kv[1]))
        line = (f"Week to {datetime.now():%-d %b %Y}: {total} session(s) active — {parts}."
                if total else f"Week to {datetime.now():%-d %b %Y}: no sessions.")
        print(line)
        send("add_comment", taskID=_housekeeping()["id"], text=line)
        return

    title = _session_name(args.codebase)
    writing = any([args.log, args.state, args.open, args.close, args.attach])
    task = _session_task(title)

    if task is None:
        if not writing:
            print(f"No session log for “{title}” yet in {SESSIONS_PROJECT}.\n"
                  f"Start one with: wf session {title!r} --log \"...\" [--state \"...\"]")
            return
        send("create_task", title=title, project=SESSIONS_PROJECT,
             notes=SESSIONS_HANDS_OFF, tags=["claude-log"],
             pinnedNote=args.state or f"First session {datetime.now():%Y-%m-%d}. No state written yet.",
             subtasks=args.open or None,
             text=args.log)
