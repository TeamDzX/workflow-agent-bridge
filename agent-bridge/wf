# ------------------------------------------------------------------ sweep

INDEX_TASK = "Sprint and Updates"
SWEEP_STATE = BRIDGE / "sweep-state.json"
PORTFOLIO_PROJECT = os.environ.get("WF_PORTFOLIO_PROJECT", "Opticell")
PORTFOLIO_TAG = "portfolio"
SELLER = os.environ.get("WF_SELLER", "opticell").lower()   # App Store seller name to match


def _app_names_from_index():
    """The index task's checklist is the source of truth for which apps exist.
    Each subtask reads "Name — version (source)"; the name is what's before
    the dash."""
    idx = _find(all_tasks(include_hidden=True), INDEX_TASK, "task", lambda r: r["title"])
    names = []
    for item in idx["subtasks"]:
        title = item.get("title", "")
        name = title.split(" — ")[0].split(" – ")[0].strip()
        if name:
            names.append((name, title))
    return idx, names


def _match_app(text, names):
    """Longest app name mentioned in the text wins, so 'myllm android' beats
    'myllm'. Case-insensitive; punctuation in names is tolerated."""
    low = text.lower()
    best, best_len = None, 0
    for name, _ in names:
        key = name.lower().replace(".stl", "").strip()
        variants = {key, key.replace(" - ", " "), key.replace("-", " "), key.replace(" ", "")}
        for v in variants:
            if v and v in low.replace("-", " ") and len(v) > best_len:
                best, best_len = name, len(v)
    return best


def _store_versions():
    """Live App Store versions for everything this seller publishes, iOS and
    Mac, keyed by lower-cased track name. Empty on any network failure — the
    sweep must still run offline."""
    import urllib.request
    out = {}
    for entity in ("software", "macSoftware"):
        url = f"https://itunes.apple.com/search?term={SELLER}&entity={entity}&limit=50&country=gb"
        try:
            with urllib.request.urlopen(url, timeout=15) as r:
                data = json.load(r)
        except Exception:
            continue
        for r in data.get("results", []):
            if SELLER in (r.get("sellerName") or "").lower():
                out[r["trackName"].lower()] = (r.get("version"), (r.get("currentVersionReleaseDate") or "")[:10], entity)
    return out


def _version_for(name, store):
    """Match a checklist name to a store track name by word overlap, preferring
    the most specific track: 'Drawpad Pro' must land on 'DrawPad Pro.stl', not
    'DrawPad' (which shares the first word and came first in the dict).
    Android rows never match — the App Store has no Android builds."""
    if "android" in name.lower():
        return None
    def words(t):
        t = t.lower().replace(".stl", "").replace("—", " ").replace("-", " ").replace(":", " ")
        return [w for w in t.split() if w]
    key = words(name)
    if not key:
        return None
    best, best_score = None, 0.0
    for track, v in store.items():
        tw = words(track)
        matched = sum(1 for w in key if w in tw)
        if matched == 0:
            continue
        # every key word should be present for a multi-word key; otherwise
        # it's a weak first-word hit and a longer track name must not win it
        if matched < len(key) and len(key) > 1:
            continue
        score = matched - 0.01 * (len(tw) - matched)
        if score > best_score:
            best, best_score = v, score
    return best


def _load_sweep_state():
    try:
        return json.loads(SWEEP_STATE.read_text())
    except (OSError, ValueError):
        return {"filedNotes": {}}


def cmd_sweep(args):
    if getattr(args, "action", None) in ("install", "status", "uninstall"):
        return sweep_launchd(args)

    idx, names = _app_names_from_index()
    state = _load_sweep_state()
    store = _store_versions()

    # 1. versions: what the checklist says vs what the store says now
    drift = []
    for name, title in names:
        live = _version_for(name, store)
        if not live:
            continue
        shown = title.split(" — ", 1)[1] if " — " in title else ""
        if live[0] and live[0] not in shown:
            drift.append((name, live[0], live[1], title))

    # 2. notes: unarchived, unconverted, mentioning an app, not yet filed
    filed = state["filedNotes"]
    matched, unmatched = [], []
    for n in all_notes():
        if n["convertedAt"] or n["id"] in filed:
            continue
        app = _match_app(n["title"] + " " + n["body"], names)
        (matched if app else unmatched).append((app, n))

    # 3. open per-app fix lists
    open_lists = [t for t in all_tasks() if t["title"].endswith(" — updates & fixes") and t["status"] != "Completed"]

    if args.json:
        print(json.dumps({
            "apps": [n for n, _ in names],
            "versionDrift": [{"app": a, "live": v, "released": d, "checklist": t} for a, v, d, t in drift],
            "notes": [{"app": a, "id": n["id"], "title": note_title(n), "body": n["body"]} for a, n in matched],
            "unmatchedNotes": [{"id": n["id"], "title": note_title(n), "body": n["body"][:200]} for _, n in unmatched],
            "openLists": [{"task": t["title"], "id": t["id"],
                           "open": [i["title"] for i in t["subtasks"] if not i.get("isCompleted")]} for t in open_lists],
        }, indent=2))
    else:
        print(f"PORTFOLIO SWEEP — {len(names)} apps on the index")
        print("\nVersion drift (store newer than the checklist):")
        for a, v, d, _ in drift or []:
            print(f"  {a:24} store {v} ({d})")
        if not drift:
            print("  none — checklist matches the App Store" if store else "  (App Store unreachable; skipped)")
        print(f"\nNotes to file ({len(matched)}):")
        for a, n in matched:
            print(f"  [{a}] {note_title(n)}  ·  {n['id']}")
        if not matched:
            print("  none")
        if unmatched:
            print(f"\nNotes mentioning no app ({len(unmatched)}) — left alone:")
            for _, n in unmatched:
                print(f"  {note_title(n)}  ·  {n['id']}")
        print(f"\nOpen fix lists ({len(open_lists)}):")
        for t in open_lists:
            pending = [i for i in t["subtasks"] if not i.get("isCompleted")]
            print(f"  {t['title']:40} {len(pending)} open")
        if not open_lists:
            print("  none yet — created on first filing")

    if not args.apply:
        return

    # ---- apply: file each matched note under its app's list -------------
    ops_supported = set(read_state().get("ops", []))
    can_reply = "update_note" in ops_supported
    for app, n in matched:
        list_title = f"{app} — updates & fixes"
        existing = next((t for t in all_tasks() if t["title"] == list_title), None)
        line = note_title(n)[:120]
        if existing:
            send("update_task", taskID=existing["id"], addSubtasks=[line])
        else:
            ver = _version_for(app, store)
            send("create_task", title=list_title, project=PORTFOLIO_PROJECT, tags=[PORTFOLIO_TAG],
                 priority="Medium", dueDate="2027-09-01",
                 pinnedNote=f"Live: {ver[0]}" if ver else "",
                 notes=f"Updates and bug fixes for {app}. Filed by the weekly sweep from Notepad notes that mention the app; each subtask is one note. The due date is parked a year out — this is a standing list, not a deadline.",
                 subtasks=[line])
        if can_reply:
            send("update_note", noteID=n["id"], appendText=f"Filed under “{list_title}”.")
        filed[n["id"]] = {"app": app, "at": datetime.now(timezone.utc).isoformat()}
    # versions: refresh the index checklist in place (replace, so re-read first)
    if drift:
        idx, names = _app_names_from_index()
        new_titles = []
        for name, title in names:
            hit = next((d for d in drift if d[0] == name), None)
            if hit:
                _, v, date, _ = hit
                src = "Mac App Store" if (_version_for(name, store) or ("", "", ""))[2] == "macSoftware" else "App Store"
                # Same shape as the hand-written lines: "29 Aug", not ISO.
                try:
                    nice = datetime.strptime(date, "%Y-%m-%d").strftime("%-d %b")
                except ValueError:
                    nice = date
                new_titles.append(f"{name} — {v}  ({src}, {nice})")
            else:
                new_titles.append(title)
        send("update_task", taskID=idx["id"], subtasks=new_titles,
             pinnedNote=f"Versions refreshed by the sweep {datetime.now():%-d %b}. {len(names)} apps.")
    SWEEP_STATE.write_text(json.dumps(state, indent=2))
    print(f"\napplied: {len(matched)} note(s) filed, {len(drift)} version(s) refreshed")


SWEEP_LABEL = "app.workflow.claude-sweep"
SWEEP_PLIST = Path.home() / "Library/LaunchAgents" / f"{SWEEP_LABEL}.plist"
SWEEP_SCRIPT = HERE / "claude-sweep.sh"


def sweep_launchd(args):
    if args.action == "status":
        print(f"launchd agent   {'installed' if SWEEP_PLIST.exists() else 'not installed'}")
        if SWEEP_PLIST.exists():
            out = os.popen(f"launchctl list 2>/dev/null | grep {SWEEP_LABEL}").read().strip()
            print(f"loaded          {out or 'no'}")
            print(f"schedule        {args.day if hasattr(args,'day') else 'see plist'}")
        print(f"last sweep      {_load_sweep_state().get('lastRun', 'never')}")
        return
    if args.action == "uninstall":
        os.system(f"launchctl bootout gui/$(id -u)/{SWEEP_LABEL} 2>/dev/null")
        if SWEEP_PLIST.exists():
            SWEEP_PLIST.unlink()
        print("Weekly sweep removed.")
        return
    # install — shares wake.config (bridge folder, claude binary, work dir)
    if not WAKE_CONFIG.exists():
        die("run `wf wake install` first — the sweep shares its config (bridge folder, claude path).")
    days = {"mon": 1, "tue": 2, "wed": 3, "thu": 4, "fri": 5, "sat": 6, "sun": 0}
    day = days.get((args.day or "mon").lower()[:3])
    if day is None:
        die("--day must be mon..sun")
    hour, minute = (args.at or "09:00").split(":")
    log_file = str(Path.home() / "Library/Logs/claude-sweep.log")
    plist = {
        "Label": SWEEP_LABEL,
        "ProgramArguments": ["/bin/bash", str(SWEEP_SCRIPT)],
        "StartCalendarInterval": {"Weekday": day, "Hour": int(hour), "Minute": int(minute)},
        "RunAtLoad": False,
        "StandardErrorPath": log_file,
    }
    SWEEP_PLIST.parent.mkdir(parents=True, exist_ok=True)
    with open(SWEEP_PLIST, "wb") as fh:
        plistlib.dump(plist, fh)
    os.system(f"launchctl bootout gui/$(id -u)/{SWEEP_LABEL} 2>/dev/null")
    rc = os.system(f"launchctl bootstrap gui/$(id -u) {SWEEP_PLIST} 2>/dev/null")
    print(f"installed  {SWEEP_PLIST}")
    print(f"runs       every {(args.day or 'mon').title()} at {args.at or '09:00'} — a session that sweeps notes, refreshes versions, updates the index")
